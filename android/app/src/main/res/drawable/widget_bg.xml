<?xml version="1.0" encoding="utf-8"?>
<!-- Widget card: soft lilac-to-white gradient, generous corner radius.
     The night variant lives in drawable-night/widget_bg.xml. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#FFFFFF"
        android:endColor="#F3E9FD" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1dp"
        android:color="#14000000" />
</shape>
