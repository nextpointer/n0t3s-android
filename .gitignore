# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# capacitor android build artifacts (platform dir itself IS committed)
android/app/build/
android/.gradle/
android/build/

# agent skills (local tooling installed via bunx skills add; not app code)
.agents/
skills-lock.json

# android release signing (never commit secrets)
android/keystore.properties
android/*.keystore
*.keystore

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env.local
.env
.env.prod

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
